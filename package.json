{
  "name": "repown",
  "version": "0.1.1",
  "description": "Use several git accounts on one machine: each repo owns its identity, so you move between repos with no switch command and never push the wrong one.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/makubexD/repown.git"
  },
  "homepage": "https://github.com/makubexD/repown#readme",
  "bugs": {
    "url": "https://github.com/makubexD/repown/issues"
  },
  "type": "module",
  "bin": {
    "repown": "dist/cli.js"
  },
  "main": "dist/cli.js",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc && tsc -p tsconfig.test.json",
    "watch": "tsc --watch",
    "test": "node --test \"test/*.test.ts\"",
    "test:quiet": "node --test --test-reporter=dot \"test/*.test.ts\"",
    "prepare": "npm run build",
    "changelog": "node scripts/release.ts changelog draft",
    "release:check": "node scripts/release.ts check repo",
    "pack:check": "npm pack --dry-run --json --ignore-scripts | node scripts/release.ts check package -",
    "release:patch": "npm version patch",
    "release:minor": "npm version minor",
    "release:major": "npm version major",
    "release:beta": "npm version prerelease --preid=beta",
    "preversion": "npm run release:check && npm run test:quiet && npm run build && npm run pack:check",
    "version": "node scripts/release.ts changelog release && git add CHANGELOG.md",
    "postversion": "node -e \"console.error('next: git push --follow-tags')\"",
    "prepublishOnly": "node scripts/release.ts check tag"
  },
  "keywords": [
    "git",
    "identity",
    "credential",
    "pre-push",
    "multi-account"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
