{
  "name": "repown",
  "version": "0.1.0",
  "description": "Use several git accounts on one machine: each repo owns its identity, so you move between repos with no switch command and never push the wrong one.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/makubexD/repown.git"
  },
  "homepage": "https://github.com/makubexD/repown#readme",
  "bugs": {
    "url": "https://github.com/makubexD/repown/issues"
  },
  "type": "module",
  "bin": {
    "repown": "dist/cli.js"
  },
  "main": "dist/cli.js",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && tsc -p tsconfig.test.json",
    "watch": "tsc --watch",
    "test": "node --test \"test/*.test.ts\"",
    "prepare": "npm run build"
  },
  "keywords": [
    "git",
    "identity",
    "credential",
    "pre-push",
    "multi-account"
  ],
  "license": "MIT",
  "private": true,
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
